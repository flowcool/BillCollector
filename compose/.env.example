# Compose inputs. These are not copied into the application automatically.
# Build this checkout first. Replace with a validated release digest when available.
BC_IMAGE=billcollector:daemon-local
BC_UID=1000
BC_GID=1000
BC_HTTP_PORT=8000
BC_PUBLIC_URL=http://127.0.0.1:8000
TZ=Europe/Zurich
# Used only when a task runs. Reuse a reachable existing private bw serve endpoint.
BW_API_URL=http://bitwarden-cli:8087
BW_API_HOST=127.0.0.1:8087
# For the bind override, use absolute pre-owned paths:
# BC_STATE_PATH=/srv/billcollector/state
# BC_RECIPES_PATH=/srv/billcollector/recipes
# For the protected-proxy override:
# BC_PROXY_NETWORK=private-proxy
# For an existing sidecar on a different private Docker network:
# BC_VAULT_NETWORK=private-vault
